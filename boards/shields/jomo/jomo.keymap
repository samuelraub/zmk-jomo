#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS_L 30 31 32
#define THUMBS_R 33 34 35

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#define QUICK_TAP_MS 175
#define HYPER(key) LC(LS(LA(LG(key))))  // Alfred's AppSwitcher hotkeys
#define SHIFT_IDLE_MS 100  // 0 = never block shift; raise if a/o lag or stray capitals appear

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS_L THUMBS_R>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L THUMBS_R>;
            hold-trigger-on-release;
        };
        // Own idle guard so capitals right after Space still shift. No thumb
        // triggers: a fast "to " would otherwise become Shift+Space.
        hsl: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <SHIFT_IDLE_MS>;
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };
        hsr: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <SHIFT_IDLE_MS>;
            tapping-term-ms = <280>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };
        ltl: layer_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
            hold-trigger-on-release;
        };
        ltr: layer_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <QUICK_TAP_MS>;
            bindings = <&mo>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L>;
            hold-trigger-on-release;
        };
        // Taps never type text here, so any other key may pick the hold.
        hyl: hyper_leader {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&leader>;
        };
        // F17-F20 are bound by the trackit Alfred workflow.
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            clock_in {
                sequence = <C I>;
                bindings = <&kp F17>;
            };
            clock_out {
                sequence = <C O>;
                bindings = <&kp F18>;
            };
            add_todo {
                sequence = <A T>;
                bindings = <&kp F19>;
            };
            add_note {
                sequence = <A N>;
                bindings = <&kp F20>;
            };
            screenshot_copy {
                sequence = <S C>;
                bindings = <&kp LC(LS(LG(N4)))>;
            };
            screenshot_save {
                sequence = <S S>;
                bindings = <&kp LS(LG(N4))>;
            };
        };
    };
};

/ {
    macros {
        tmux: tmux {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <250>;
            bindings
                = <&macro_tap &kp HYPER(T)>
                , <&macro_wait_time 20>
                , <&macro_tap &kp LC(A)>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };

        tmux_prefix: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <250>;
            bindings
                = <&macro_tap &kp HYPER(T)>
                , <&macro_wait_time 20>
                , <&macro_tap &kp LC(A)>
                ;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        // The idle guard keeps rolls like "would" and "value" from firing it.
        combo_caps_word_l {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <2 3>;
            bindings = <&caps_word>;
        };
        combo_caps_word_r {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <6 7>;
            bindings = <&caps_word>;
        };
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        system {
            if-layers = <1 5>;
            then-layer = <6>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &kp Q            &kp W           &kp F          &kp P           &kp B        &kp J        &kp L          &kp U           &kp Y           &kp SQT
                &hsl LSHIFT A    &hml LCTRL R    &hml LALT S    &hml LGUI T     &kp G        &kp M        &hmr RGUI N    &hmr RALT E     &hmr RCTRL I    &hsr RSHIFT O
                &kp Z            &kp X           &kp C          &kp D           &kp V        &kp K        &kp H          &kp COMMA       &kp DOT         &kp FSLH
                                                 &ltl 1 BSPC    &ltl 2 SPACE    &ltl 3 TAB   &ltr 4 RET   &ltr 5 ESC     &hyl HYPER(LGUI) 0
            >;
        };

        tmux_layer { // Layer 1
            bindings = <
                &none            &none           &none          &none           &none        &tmux C      &tmux Z        &tmux Y         &tmux S         &tmux V
                &kp LSHIFT       &kp LCTRL       &kp LALT       &kp LGUI        &none        &tmux_prefix &kp LC(LEFT)   &kp LC(DOWN)    &kp LC(UP)      &kp LC(RIGHT)
                &none            &none           &none          &none           &none        &tmux LC(A)  &tmux N1       &tmux N2        &tmux N3        &tmux N4
                                                 &none          &none           &none        &none        &trans         &none
            >;
        };

        nav_layer { // Layer 2
            bindings = <
                &none            &none           &none          &none           &none        &kp RG(Z)    &kp RG(V)      &kp RG(C)       &kp RG(X)       &kp RG(LS(Z))
                &kp LSHIFT       &kp LCTRL       &kp LALT       &kp LGUI        &none        &caps_word   &kp LEFT       &kp DOWN        &kp UP          &kp RIGHT
                &none            &none           &none          &none           &none        &none        &kp RA(RG(V))  &kp PG_DN       &kp PG_UP       &none
                                                 &none          &none           &none        &none        &none          &none
            >;
        };

        ctl_layer { // Layer 3
            bindings = <
                &none            &none           &none          &none           &none        &kp C_MUTE   &kp C_VOL_DN   &kp C_VOL_UP    &kp C_BRI_DN    &kp C_BRI_UP
                &none            &none           &none          &none           &none        &none        &msc SCRL_LEFT &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT
                &none            &none           &none          &none           &none        &none        &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT
                                                 &none          &none           &none        &mkp MCLK    &mkp LCLK      &mkp RCLK
            >;
        };

        sym_layer { // Layer 4
            bindings = <
                &kp LBRC         &kp AMPS        &kp STAR       &kp QMARK       &kp RBRC     &none        &none          &none           &none           &none
                &kp COLON        &kp DOLLAR      &kp PRCNT      &kp CARET       &kp PLUS     &none        &kp RGUI       &kp RALT        &kp RCTRL       &kp RSHIFT
                &kp TILDE        &kp EXCL        &kp AT         &kp HASH        &kp PIPE     &none        &none          &none           &none           &none
                                                 &kp LPAR       &kp RPAR        &kp UNDER    &none        &none          &none
            >;
        };

        num_layer { // Layer 5
            bindings = <
                &kp LBKT         &kp N7          &kp N8         &kp N9          &kp RBKT     &none        &none          &none           &none           &none
                &kp SEMI         &kp N4          &kp N5         &kp N6          &kp EQUAL    &none        &kp RGUI       &kp RALT        &kp RCTRL       &kp RSHIFT
                &kp GRAVE        &kp N1          &kp N2         &kp N3          &kp BSLH     &none        &none          &kp COMMA       &kp DOT         &kp FSLH
                                                 &trans         &kp N0          &kp MINUS    &none        &none          &none
            >;
        };

        system_layer { // Layer 6, Backspace + Esc held together
            bindings = <
                &bootloader      &none           &none          &none           &none        &none        &none          &none           &none           &bootloader
                &soft_off        &none           &none          &none           &none        &none        &none          &none           &none           &bt BT_CLR_ALL
                &sys_reset       &none           &none          &none           &none        &none        &none          &none           &none           &sys_reset
                                                 &none          &none           &none        &none        &none          &none
            >;
        };

    };
 };
